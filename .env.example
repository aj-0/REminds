# Get from @BotFather
BOT_TOKEN=123456789:ABC-DEF_GHIjklMnOpQrStUvWxYz

# Database: SQLite for local/dev, Postgres URL for Render production
# Render provides 'DATABASE_URL' automatically for managed Postgres
DATABASE_URL=sqlite:///./data/reminders.db

# Flask Secret for sessions (generate random string)
SECRET_KEY=super-secret-change-me

# Webhook mode (Render Web Service uses polling via background thread, but needs port)
PORT=10000
WEBHOOK_URL=  # Leave empty for polling mode on Render Free Tier
