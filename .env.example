# Required. Get this from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# Optional. Defaults to sqlite:///reminders.db (fine locally; EPHEMERAL on Render free tier).
# For persistence on Render, set this to a Postgres URL, e.g.:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///reminders.db

# Optional locally. Render sets this automatically in production -- do not set it
# manually in the Render dashboard.
PORT=5000
